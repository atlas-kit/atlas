{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "ENABLE_UNITY_BUILD": "ON",
        "OPTIONS_ENABLE_SCCACHE": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "displayName": "Windows - Release",
      "description": "Windows Release build with static linking via vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-release",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-windows-static-release",
        "VCPKG_BUILD_TYPE": "release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-release",
      "displayName": "Windows - Debug",
      "description": "Windows Debug build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-windows-debug",
        "VCPKG_BUILD_TYPE": "debug",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "windows-release-tests",
      "inherits": "windows-release",
      "displayName": "Windows - Release (with tests)",
      "description": "Windows Release build with unit tests enabled",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-windows-static-release-tests"
      }
    },
    {
      "name": "windows-release-benchmarks",
      "inherits": "windows-release",
      "displayName": "Windows - Release (with benchmarks)",
      "description": "Windows Release build with benchmarks enabled",
      "cacheVariables": {
        "BUILD_BENCHMARKING": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-windows-static-release-benchmarks"
      }
    },
    {
      "name": "windows-release-asan",
      "inherits": "windows-release",
      "displayName": "Windows - Release + ASAN",
      "description": "Windows Release build with Address Sanitizer",
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-windows-asan"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "Linux - Release",
      "description": "Linux Release build with vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-linux",
        "VCPKG_BUILD_TYPE": "release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-release",
      "displayName": "Linux - Debug",
      "description": "Linux Debug build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-linux-debug",
        "VCPKG_BUILD_TYPE": "debug",
        "ENABLE_UNITY_BUILD": "OFF"
      }
    },
    {
      "name": "linux-release-tests",
      "inherits": "linux-release",
      "displayName": "Linux - Release (with tests)",
      "description": "Linux Release build with unit tests enabled",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-linux-tests"
      }
    },
    {
      "name": "linux-release-benchmarks",
      "inherits": "linux-release",
      "displayName": "Linux - Release (with benchmarks)",
      "description": "Linux Release build with benchmarks enabled",
      "cacheVariables": {
        "BUILD_BENCHMARKING": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-linux-benchmarks"
      }
    },
    {
      "name": "linux-debug-asan",
      "inherits": "linux-debug",
      "displayName": "Linux - Debug + ASAN",
      "description": "Linux Debug build with Address Sanitizer",
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-linux-debug-asan"
      }
    },
    {
      "name": "vcpkg",
      "description": "Legacy preset - configure with vcpkg toolchain (Ninja Multi-Config)",
      "hidden": false,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release-tests",
      "configurePreset": "windows-release-tests"
    },
    {
      "name": "windows-release-benchmarks",
      "configurePreset": "windows-release-benchmarks"
    },
    {
      "name": "windows-release-asan",
      "configurePreset": "windows-release-asan"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release-tests",
      "configurePreset": "linux-release-tests"
    },
    {
      "name": "linux-release-benchmarks",
      "configurePreset": "linux-release-benchmarks"
    },
    {
      "name": "linux-debug-asan",
      "configurePreset": "linux-debug-asan"
    },
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "windows-release-tests",
      "inherits": "base",
      "configurePreset": "windows-release-tests"
    },
    {
      "name": "windows-release-asan",
      "inherits": "base",
      "configurePreset": "windows-release-asan"
    },
    {
      "name": "linux-release-tests",
      "inherits": "base",
      "configurePreset": "linux-release-tests"
    },
    {
      "name": "linux-release-benchmarks",
      "inherits": "base",
      "configurePreset": "linux-release-benchmarks"
    },
    {
      "name": "linux-debug-asan",
      "inherits": "base",
      "configurePreset": "linux-debug-asan"
    }
  ]
}
